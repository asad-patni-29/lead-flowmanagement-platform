# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/leadflow

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# CORS Configuration
CORS_ORIGIN=*

# Seed script credentials (used by `npm run seed`)
SEED_ADMIN_EMAIL=admin@leadflow.test
SEED_ADMIN_PASSWORD=Admin@123
SEED_MEMBER_EMAIL=member@leadflow.test
SEED_MEMBER_PASSWORD=Member@123
